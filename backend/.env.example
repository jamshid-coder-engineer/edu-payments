# SQLite fayli (prisma/ papkasiga nisbatan yo'l)
DATABASE_URL="file:./dev.db"

# Backend porti
PORT=3000

# "Bugun" va "joriy oy" shu vaqt zonasi bo'yicha aniqlanadi
APP_TIMEZONE=Asia/Tashkent

# Frontend manzili (CORS). Bir nechta bo'lsa vergul bilan
CORS_ORIGIN=http://localhost:5173

# Bitta IP dan daqiqasiga ruxsat etilgan so'rovlar soni
RATE_LIMIT_PER_MINUTE=120
